// Диаграммы Регламента ликвидной демократии.
#import "../_diagrams.typ": u, edge, arrow, node, note

// Цепочка делегирования с затуханием 0,8 за шаг и пределом в 3 перехода
#let delegation-chain = box(width: 16 * u, height: 3.3 * u, {
  let names = ([Участник], [Делегат 1], [Делегат 2], [Делегат 3])
  let weights = ([вес 1,0], [×0,8 → 0,80], [×0,8 → 0,64], [×0,8 → 0,51])
  for i in range(4) {
    let x = i * 4.2
    node(x, 0.5, 3.4, 1.3, names.at(i), weights.at(i), current: i == 0)
    if i > 0 {
      arrow((x - 0.8, 1.15), (x, 1.15))
      note(x - 0.8, 0.55, 0.8, [#i], pos: center)
    }
  }
  note(0, 0, 16, [Номер над стрелкой — шаг цепочки. Делегат учитывается, только если у него есть подтверждённые навыки в треке.])
  note(0, 2.15, 16, [Четвёртого перехода нет: цепочка обрывается на 3 шагах. Участник может запретить дальнейшую передачу — тогда цепочка заканчивается на Делегате 1. \ Если участник голосует сам, его личный голос перекрывает голос любого делегата по этому предложению.])
})

// Предложение, затрагивающее несколько треков, проходит каждый из них, затем петиция и вето палаты участников
#let multitrack-flow = box(width: 16 * u, height: 3.4 * u, {
  node(0, 1.1, 3, 1.2, [Предложение], [Треки A и B])
  node(4, 0, 3.6, 1.2, [Голосование в треке A], [Кворум и порог трека])
  node(4, 2.2, 3.6, 1.2, [Голосование в треке B], [Кворум и порог трека])
  node(8.6, 1.1, 3.4, 1.2, [Принято], [Только если прошло во всех треках], current: true)
  node(13, 1.1, 3, 1.2, [Петиция и вето], [Палата участников, бюджет], dashed: true)
  arrow((3, 1.5), (4, 0.6))
  arrow((3, 1.9), (4, 2.8))
  arrow((7.6, 0.6), (8.6, 1.5))
  arrow((7.6, 2.8), (8.6, 1.9))
  arrow((12, 1.7), (13, 1.7))
})
