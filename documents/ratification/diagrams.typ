// Диаграммы Регламента ратификации нормативных актов.
#import "../_diagrams.typ": u, edge, arrow, node, note
#import "../_template.typ": ink, muted

// Кривая требуемой поддержки на этапе палаты участников: линейно от 20% до 5% базы за 10 дней; раньше 4-го дня этап не завершается
#let support-curve = box(width: 16 * u, height: 6.2 * u, {
  // Холст графика: x0..x1 — дни 0..10, y0..y1 — поддержка 25%..0%
  let (x0, x1, y0, y1) = (1.6, 15.4, 0.4, 5.0)
  let px(d) = x0 + (x1 - x0) * d / 10
  let py(p) = y1 - (y1 - y0) * p / 25

  // Оси
  arrow((x0, y1), (x1 + 0.3, y1))
  arrow((x0, y1), (x0, y0 - 0.2))
  for p in (5, 10, 15, 20) {
    place(top + left, line(start: (x0 * u, py(p) * u), end: (x1 * u, py(p) * u), stroke: (paint: edge.lighten(40%), thickness: 0.3pt, dash: "dotted")))
    note(0, py(p) - 0.2, 1.4, [#p%], pos: right)
  }
  for d in (0, 4, 7, 10) {
    note(px(d) - 0.6, y1 + 0.12, 1.2, [день #d], pos: center)
  }

  // Зона, где этап ещё не может завершиться (дни 0–4)
  place(top + left, dx: px(0) * u, dy: y0 * u, rect(width: (px(4) - px(0)) * u, height: (y1 - y0) * u, fill: luma(245), stroke: none))
  note(px(0) + 0.15, y0 + 0.1, px(4) - px(0) - 0.3, [Первые 4 дня этап не может завершиться])

  // Кривая поддержки
  place(top + left, line(start: (px(0) * u, py(20) * u), end: (px(10) * u, py(5) * u), stroke: 1.2pt + ink))
  note(px(6.2), py(11) - 0.75, 5, [Требуемая поддержка: \ 20% базы → 5% базы])

  note(x0, y1 + 0.6, 14, [Этап пройден, когда фактическая поддержка выше линии, одобрение не ниже 2/3 и оба условия держатся 48 часов подряд. В палате треков кривая та же, но этап длится 5 дней, а подтверждение — 24 часа. Значения — предлагаемые, в тексте Регламента они в скобках.])
})

// Два порядка: ратификация и упрощённый порядок
#let paths = box(width: 16 * u, height: 4.6 * u, {
  node(0, 0, 3.4, 1.3, [Проект], [Обсуждение не менее [7] дней])
  node(4.4, 0, 5.2, 1.3, [Ратификация], [Палата треков до [5] дн. → палата участников до [10] дн.], current: true)
  node(10.8, 0, 5.2, 1.3, [Новая версия акта], [Прежние версии сохраняются])
  arrow((3.4, 0.65), (4.4, 0.65))
  note(3.45, 0.1, 0.9, [сущ.], pos: center)
  arrow((9.6, 0.65), (10.8, 0.65))

  node(4.4, 2.9, 5.2, 1.3, [Упрощённый порядок], [Правки, параметры, спецификации], dashed: true)
  arrow((1.7, 1.3), (1.7, 3.55), head: false)
  arrow((1.7, 3.55), (4.4, 3.55))
  note(1.85, 2.2, 2.4, [ред.])
  arrow((9.6, 3.55), (13.4, 3.55), head: false)
  arrow((13.4, 3.55), (13.4, 1.3))
  note(9.7, 3.0, 3.6, [петиция не набрала порог])
  arrow((7.0, 2.9), (7.0, 1.3))
  note(7.15, 1.75, 3.4, [петиция набрала порог → ратификация])
})
