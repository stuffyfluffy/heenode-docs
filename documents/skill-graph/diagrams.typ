// Диаграммы Спецификации графа навыков.
#import "../_diagrams.typ": u, arrow, node, note

// Пример участка графа: пререквизиты из каркаса ESCO, навык subDAO и узел оборудования
#let graph-example = box(width: 16 * u, height: 5.4 * u, {
  note(0, 0, 4.4, [Каркас ESCO — вся сеть])
  note(5.6, 0, 10.4, [Участок subDAO «Робототехника»])

  node(0, 0.6, 3.6, 1.2, [Linux], [esco:skill/…])
  node(0, 2.6, 3.6, 1.2, [Python], [esco:skill/…])
  node(5.6, 1.6, 3.6, 1.2, [ROS], [Требует Linux и Python])
  node(11.2, 1.6, 4.8, 1.2, [Управление манипулятором], [Требует ROS и оборудование], current: true)
  node(5.6, 4.0, 3.6, 1.2, [Манипулятор с ROS], [Узел оборудования], dashed: true)

  arrow((3.6, 1.2), (5.6, 2.0))
  arrow((3.6, 3.2), (5.6, 2.4))
  arrow((9.2, 2.2), (11.2, 2.2))
  arrow((9.2, 4.6), (12.4, 2.8))
  note(10.3, 4.2, 5.7, [Доступен в лабораториях-участниках сети])
})

