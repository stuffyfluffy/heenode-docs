// Диаграммы Регламента форка SubDAO.
#import "../_diagrams.typ": u, arrow, node, note, stage, gate

// Жизненный цикл форка: форк → инкубатор → статус subDAO → конкуренция
#let fork-lifecycle = stack(
  stage([Форк], [Любой человек копирует базу знаний и участок графа — сразу, бесплатно и без разрешения], n: 1),
  gate([сразу], diamond: false),
  stage([Инкубатор], [Форк работает и зарабатывает сам, но без бюджета из общей казны], n: 2),
  gate[[N] участников с репутацией в треке и инкубационный период [M] мес.],
  stage([Статус subDAO], [Бюджет из общей казны и место в управлении; развёртывается фабрикой subDAO со ссылкой на родителя], n: 3, current: true),
  gate([постоянно], diamond: false),
  stage([Конкуренция], [Финансирование распределяется по результатам учеников: сильнейшая версия курса побеждает естественно], n: 4),
)

