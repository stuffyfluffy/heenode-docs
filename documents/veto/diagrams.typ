// Диаграммы Регламента вето палаты участников.
#import "../_diagrams.typ": u, edge, arrow, node, note

// Путь бюджетного решения: петиция → голосование о вето → вето или исполнение
#let veto-flow = box(width: 16 * u, height: 4.4 * u, {
  node(0, 1.1, 2.8, 1.2, [Решение], [Палата треков, бюджет])
  node(3.6, 1.1, 3, 1.2, [Петиция], [Окно [N] дней, исполнение ждёт], current: true)
  node(8.4, 1.1, 3, 1.2, [Голосование], [«За вето» / «против» / «воздерж.»], current: true)
  node(12.8, 0, 3.2, 1.2, [Вето], [«За» > «против» при кворуме])
  node(12.8, 2.6, 3.2, 1.2, [Исполнение], [Во всех остальных случаях], dashed: true)

  arrow((2.8, 1.7), (3.6, 1.7))
  arrow((6.6, 1.7), (8.4, 1.7))
  note(6.6, 1.15, 1.8, [порог Y%], pos: center)
  arrow((11.4, 1.4), (12.8, 0.6))
  arrow((11.4, 2.0), (12.8, 3.0))

  // Петиция не набрала порог — решение исполняется после окна
  arrow((5.1, 2.3), (5.1, 3.4), head: false)
  arrow((5.1, 3.4), (12.8, 3.4))
  note(5.3, 3.55, 7.3, [порог не набран до закрытия окна петиции])
})
