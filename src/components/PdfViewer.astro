---
interface Props {
  src: string;
  title: string;
  pages: number;
}
const { src, title, pages } = Astro.props;
---

<fd-pdf-viewer data-src={src} class="viewer">
  <div class="viewer__toolbar" role="toolbar" aria-label="Просмотр PDF">
    <button type="button" class="fd-btn icon" data-action="prev" aria-label="Предыдущая страница">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
    </button>
    <span class="fd-mono status"><span data-current>1</span> / <span data-total>{pages}</span></span>
    <button type="button" class="fd-btn icon" data-action="next" aria-label="Следующая страница">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
    </button>
    <span class="sep" aria-hidden="true"></span>
    <button type="button" class="fd-btn icon" data-action="zoom-out" aria-label="Уменьшить">−</button>
    <span class="fd-mono status" data-zoom>100%</span>
    <button type="button" class="fd-btn icon" data-action="zoom-in" aria-label="Увеличить">+</button>
  </div>

  <div class="viewer__body">
    <nav class="viewer__thumbs" aria-label="Страницы"></nav>
    <div class="viewer__pages" tabindex="0" aria-label={`Страницы документа «${title}»`}>
      <p class="viewer__fallback">
        Загружаю документ… Если он не открылся, <a href={src}>откройте PDF напрямую</a>.
      </p>
    </div>
  </div>
</fd-pdf-viewer>

<script>
  import * as pdfjs from 'pdfjs-dist';
  import workerUrl from 'pdfjs-dist/build/pdf.worker.min.mjs?url';

  pdfjs.GlobalWorkerOptions.workerSrc = workerUrl;

  const ZOOMS = [0.5, 0.75, 1, 1.25, 1.5, 2];

  class PdfViewer extends HTMLElement {
    private doc?: pdfjs.PDFDocumentProxy;
    private zoomIndex = 2;
    private current = 1;
    private pagesEl!: HTMLElement;
    private thumbsEl!: HTMLElement;
    private observer?: IntersectionObserver;
    private renderToken = 0;

    async connectedCallback() {
      this.pagesEl = this.querySelector('.viewer__pages')!;
      this.thumbsEl = this.querySelector('.viewer__thumbs')!;
      this.querySelector('[data-action="prev"]')!.addEventListener('click', () => this.goTo(this.current - 1));
      this.querySelector('[data-action="next"]')!.addEventListener('click', () => this.goTo(this.current + 1));
      this.querySelector('[data-action="zoom-in"]')!.addEventListener('click', () => this.zoom(1));
      this.querySelector('[data-action="zoom-out"]')!.addEventListener('click', () => this.zoom(-1));

      try {
        this.doc = await pdfjs.getDocument({ url: this.dataset.src! }).promise;
        this.querySelector('[data-total]')!.textContent = String(this.doc.numPages);
        await this.renderThumbs();
        await this.renderPages();
      } catch (err) {
        console.error(err);
        this.pagesEl.querySelector('.viewer__fallback')!.textContent = '';
        this.pagesEl.querySelector('.viewer__fallback')!.append(
          'Не удалось показать PDF. ',
          Object.assign(document.createElement('a'), { href: this.dataset.src!, textContent: 'Открыть файл напрямую' }),
        );
      }
    }

    private async drawPage(n: number, canvas: HTMLCanvasElement, scale: number) {
      const page = await this.doc!.getPage(n);
      const viewport = page.getViewport({ scale });
      const ratio = window.devicePixelRatio || 1;
      canvas.width = Math.floor(viewport.width * ratio);
      canvas.height = Math.floor(viewport.height * ratio);
      canvas.style.width = `${Math.floor(viewport.width)}px`;
      canvas.style.aspectRatio = `${viewport.width} / ${viewport.height}`;
      await page.render({
        canvas,
        canvasContext: canvas.getContext('2d')!,
        viewport,
        transform: ratio !== 1 ? [ratio, 0, 0, ratio, 0, 0] : undefined,
      } as any).promise;
    }

    private async renderThumbs() {
      this.thumbsEl.replaceChildren();
      for (let n = 1; n <= this.doc!.numPages; n++) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'thumb';
        btn.setAttribute('aria-label', `Страница ${n}`);
        const canvas = document.createElement('canvas');
        const label = document.createElement('span');
        label.textContent = String(n);
        btn.append(canvas, label);
        btn.addEventListener('click', () => this.goTo(n));
        this.thumbsEl.append(btn);
        await this.drawPage(n, canvas, 0.16);
      }
      this.markCurrent();
    }

    /** Масштаб «по ширине»: страница целиком помещается в область просмотра (не крупнее 1.4). */
    private async fitScale() {
      const page = await this.doc!.getPage(1);
      const width = page.getViewport({ scale: 1 }).width;
      const style = getComputedStyle(this.pagesEl);
      const available = this.pagesEl.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
      return Math.min(1.4, Math.max(0.3, available / width));
    }

    private async renderPages() {
      const token = ++this.renderToken;
      const scale = ZOOMS[this.zoomIndex] * (await this.fitScale());
      this.observer?.disconnect();
      this.pagesEl.replaceChildren();
      this.observer = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (visible) {
            this.current = Number((visible.target as HTMLElement).dataset.page);
            this.markCurrent();
          }
        },
        { root: this.pagesEl, threshold: [0.25, 0.5, 0.75] },
      );
      for (let n = 1; n <= this.doc!.numPages; n++) {
        if (token !== this.renderToken) return;
        const wrap = document.createElement('div');
        wrap.className = 'page';
        wrap.dataset.page = String(n);
        const canvas = document.createElement('canvas');
        canvas.setAttribute('role', 'img');
        canvas.setAttribute('aria-label', `Страница ${n}`);
        wrap.append(canvas);
        this.pagesEl.append(wrap);
        this.observer.observe(wrap);
        await this.drawPage(n, canvas, scale);
      }
      this.querySelector('[data-zoom]')!.textContent = `${Math.round(ZOOMS[this.zoomIndex] * 100)}%`;
    }

    private goTo(n: number) {
      if (!this.doc) return;
      n = Math.min(Math.max(1, n), this.doc.numPages);
      this.current = n;
      this.markCurrent();
      const target = this.pagesEl.querySelector<HTMLElement>(`[data-page="${n}"]`);
      if (target) this.pagesEl.scrollTo({ top: target.offsetTop - this.pagesEl.offsetTop - 16, behavior: 'smooth' });
    }

    private zoom(dir: number) {
      const next = Math.min(Math.max(0, this.zoomIndex + dir), ZOOMS.length - 1);
      if (next === this.zoomIndex || !this.doc) return;
      this.zoomIndex = next;
      const page = this.current;
      this.renderPages().then(() => this.goTo(page));
    }

    private markCurrent() {
      this.querySelector('[data-current]')!.textContent = String(this.current);
      this.thumbsEl.querySelectorAll('.thumb').forEach((t, i) => {
        if (i + 1 === this.current) t.setAttribute('aria-current', 'page');
        else t.removeAttribute('aria-current');
      });
    }
  }

  customElements.define('fd-pdf-viewer', PdfViewer);
</script>

<style>
  .viewer {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }
  .viewer__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .icon { min-width: 40px; padding: 0 0.625rem; }
  .status { font-size: 0.875rem; padding: 0 0.25rem; }
  .sep { width: 1px; height: 24px; background: var(--fd-line); margin: 0 0.25rem; }
  .viewer__body {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .viewer__thumbs {
    display: none;
    flex-direction: column;
    gap: 0.75rem;
    max-height: 80vh;
    overflow-y: auto;
    padding: 2px;
  }
  @media (min-width: 50rem) {
    .viewer__thumbs { display: flex; }
  }
  .viewer__thumbs :global(.thumb) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }
  .viewer__thumbs :global(.thumb canvas) {
    display: block;
    background: #ffffff;
    border: 1px solid var(--fd-line);
    border-radius: 4px;
  }
  .viewer__thumbs :global(.thumb[aria-current='page'] canvas) {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }
  .viewer__thumbs :global(.thumb[aria-current='page']) { color: var(--sl-color-white); }
  .viewer__pages {
    flex: 1;
    min-width: 0;
    max-height: 80vh;
    overflow: auto;
    padding: 1.5rem;
    border-radius: 0.875rem;
    background: var(--fd-surface-sunk);
    display: flex;
    flex-direction: column;
    align-items: safe center;
    gap: 1.5rem;
  }
  .viewer__pages :global(.page canvas) {
    display: block;
    max-width: none;
    background: #ffffff;
    box-shadow: 0 1px 3px rgba(20, 22, 28, 0.12), 0 8px 24px rgba(20, 22, 28, 0.08);
  }
  .viewer__fallback { color: var(--sl-color-gray-3); }
</style>
